#!/usr/bin/env bash
# claude-rc-window-stop <name>
#
# Stop the tmux window hosting a `claude rc` instance. Sends SIGTERM to the
# pane's process and gives it a few seconds to exit on its own -- confirmed
# by testing that `claude rc` treats SIGTERM as a clean-shutdown request and
# closes its own tmux window as part of exiting, unlike a hangup (what
# `tmux kill-window` sends directly), which just leaves a dead pane behind.
# Falls back to a forced `kill-window` if it's still there after the grace
# period (e.g. an already-crashed/dead pane from a previous run, which has
# no live process left to signal).
#
# Used as ExecStop for the claude-rc@.service systemd template.
set -euo pipefail

name="${1:?usage: claude-rc-window-stop <name>}"
session="crc"
target="$session:$name"
grace_period_iters=10   # 10 * 0.5s = 5s, comfortably above the ~2s observed

pid="$(tmux list-panes -t "$target" -F '#{pane_pid}' 2>/dev/null || true)"
if [[ -n "$pid" ]]; then
  kill -TERM "$pid" 2>/dev/null || true
fi

for ((i = 0; i < grace_period_iters; i++)); do
  tmux has-session -t "=$session" 2>/dev/null || exit 0
  tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null | grep -qx "$name" || exit 0
  sleep 0.5
done

# Still there after the grace period: force it.
tmux kill-window -t "$target" 2>/dev/null || true

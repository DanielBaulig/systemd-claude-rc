#!/usr/bin/env bash
# claude-rc-grind [--dry-run] [--select] [--status] [--hold <hours>] [--release]
#
# Spend 5-hour-window quota that would otherwise expire, on one work item from
# a project's GRIND.md. Runs only in the tail of a window, under a ceiling that
# keeps working hours yours, and only while the weekly burn-down allows it.
#
# One job at a time. An interrupted job is resumed on a later wake, never
# restarted -- a forty-turn item that dies at turn thirty-eight would otherwise
# re-do the same thirty turns every window and leak a dirty worktree each time.
# After MAX_ATTEMPTS it is parked: the worktree is `git worktree lock`ed (a
# reaper refusal, so reclamation cannot take it) and the issue is labelled for
# a human. Removing that label hands it back. A job whose work is on no single
# ticket (triage, say) is abandoned rather than parked -- there is no issue to
# hand anyone -- and its worktree is left for the reaper.
#
# Two sessions per job. A read-only selector reads GRIND.md and the tracker and
# names the work; an executor does it. The split exists so the executor's
# opening message can be a slash command: a skill marked
# disable-model-invocation can only be started by a user turn, and the engine's
# prompt is one. That turn carries the human's authority, so nothing the
# selector says reaches it unchecked -- the selector has been reading issue
# text. Its ticket must be an integer, its passage a verbatim excerpt of
# GRIND.md, and each skill a /name that passage contains. The engine knows
# nothing of GRIND.md's shape; it only checks claims against it.
#
# Executes by default; --dry-run decides and prints without spawning;
# --select runs the selector alone, prints what it chose, and starts nothing.
set -uo pipefail   # not -e: a failed gh/curl is a decision input, not a crash

# --- configuration ----------------------------------------------------------
# Every constant here is meant to be tuned in place. The pacing ones were set
# by judgement, not measurement: no record of a weekly burn-down existed when
# this was written, which is why the gate logs weekly utilization on every wake.

WORK_DAYS="${GRIND_WORK_DAYS:-Sun Mon Tue Wed Thu Fri}"
WORK_START="${GRIND_WORK_START:-8}"     # local hour, inclusive
WORK_END="${GRIND_WORK_END:-19}"        # local hour, exclusive

TAIL_MIN=60          # the window's last hour: the earliest we touch anything
FINAL_MIN=15         # the last quarter hour: what is left is lost anyway
CEIL_WORK_TAIL=50    # session-utilization ceilings, percent
CEIL_OFF_TAIL=75
CEIL_WORK_FINAL=75
CEIL_OFF_FINAL=100

# The weekly ceiling steps at WORK_END on the named day and holds until the
# next step, so it never widens while the human is mid-workday. Wednesday
# daytime therefore runs at Tuesday's number.
WEEK_SUN=0
WEEK_MON=0
WEEK_TUE=25
WEEK_WED=50
WEEK_THU=75
WEEK_FRI=100
GRACE_SEC=60         # refuse a reading taken as the window rolls; see below

MODEL="${GRIND_MODEL:-opus}"
BRAKE_USD="${GRIND_BRAKE_USD:-20}"   # runaway brake, not a ceiling: the budget
                                     # is checked after a turn completes, so a
                                     # run overshoots it by one full turn
# Selection is reading and judgement -- whose turn a grilling thread is on, say
# -- not code, and a wrong pick costs a whole executor run. Hence not haiku.
SELECT_MODEL="${GRIND_SELECT_MODEL:-sonnet}"
SELECT_BRAKE_USD="${GRIND_SELECT_BRAKE_USD:-2}"
PASSAGE_MIN=40       # chars; a passage short enough to match anywhere names nothing
MAX_ATTEMPTS=3
MAX_PARKED=3
PARK_WARN_DAYS=28    # transcripts age out at 30; after that the session id
                     # resolves to nothing and only the branch survives
GRIND_DOC=GRIND.md
# How to run as a grind job, in any project; GRIND_DOC only says what to work on.
# Found beside this script's real path, since ~/.local/bin holds a symlink to it.
GRIND_SKILL="$(dirname "$(readlink -f "$0")")/../skills/claude-rc-grind/SKILL.md"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-rc-grind"
STATE="$STATE_DIR/state.json"
LOG="$STATE_DIR/grind.log"
HOLD="$STATE_DIR/hold"
LOCKFILE="$STATE_DIR/lock"
projects_dir="${CLAUDE_RC_PROJECTS_DIR:-$HOME/projects}"

USAGE_URL=https://api.anthropic.com/api/oauth/usage

# --- argument handling ------------------------------------------------------
dry_run=0; mode=run; hold_hours=
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) dry_run=1; shift ;;
    --select)  mode=select; shift ;;
    --status)  mode=status; shift ;;
    --hold)    mode=hold; hold_hours="${2:?--hold needs a number of hours}"; shift 2 ;;
    --release) mode=release; shift ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "usage: claude-rc-grind [--dry-run] [--select] [--status] [--hold N] [--release]" >&2; exit 2 ;;
  esac
done

mkdir -p "$STATE_DIR"
[[ -f "$STATE" ]] || echo '{"active":null,"parked":[]}' >"$STATE"

log() { printf '%s %s\n' "$(date -Is)" "$*" >>"$LOG"; }
say() { printf '%s\n' "$*"; }

# --- json helpers -----------------------------------------------------------
jget() {  # jget <file> <jq filter> [--arg k v ...]  -- prints '' on any failure
  local f="$1" filter="$2"; shift 2
  jq -r "$@" "$filter" "$f" 2>/dev/null
}

# Every value crosses into jq as --arg, never interpolated into the filter: a
# worktree path is attacker-adjacent input as far as quoting is concerned, and
# temp-file-plus-rename is what makes a crash mid-write leave the old state.
state_jq() {  # state_jq <jq filter> [--arg k v ...]
  local filter="$1"; shift
  jq "$@" "$filter" "$STATE" >"$STATE.tmp" 2>/dev/null && mv "$STATE.tmp" "$STATE"
}

# --- the quota reading ------------------------------------------------------
# The grant is nested differently depending on how the account was logged in,
# so this descends rather than naming a path.
oauth_token() {
  jq -r '[.. | objects | .accessToken?
          | select(type == "string" and startswith("sk-ant-oat"))] | first // empty' \
     "$HOME/.claude/.credentials.json" 2>/dev/null
}

# Prints: <session_pct> <session_secs_left> <weekly_pct> <weekly_secs_left>
# Empty output means the reading failed, which is always a refusal to act.
read_quota() {
  local tok body
  tok=$(oauth_token); [[ -n "$tok" ]] || return 1
  body=$(curl -sS --max-time 20 -H "Authorization: Bearer $tok" \
              -H "anthropic-beta: oauth-2025-04-20" "$USAGE_URL" 2>/dev/null) || return 1
  # resets_at carries microseconds and a numeric offset; fromdateiso8601 takes
  # neither, hence the two subs. Read `limits`, not the top-level objects: it is
  # the only place is_active and the per-model buckets appear.
  # jq exits 0 on `empty`, so the status alone does not catch a body without a
  # session limit (an error payload, say). Callers `set -- $q` under set -u.
  local q
  q=$(printf '%s' "$body" | jq -r --argjson now "$(date +%s)" '
      def secs($x): if $x == null or $x.resets_at == null then -1
                    else (($x.resets_at | sub("\\.[0-9]+"; "") | sub("\\+00:00"; "Z")
                           | fromdateiso8601) - $now | floor) end;
      (.limits // []) as $l
      | ($l | map(select(.kind == "session")) | first) as $s
      | ($l | map(select(.kind == "weekly_all")) | first) as $w
      | if $s == null then empty
        else "\($s.percent) \(secs($s)) \($w.percent // 0) \(secs($w))" end' 2>/dev/null) || return 1
  [[ -n "$q" ]] || return 1
  printf '%s\n' "$q"
}

# --- the ceiling ------------------------------------------------------------
in_work_hours() {
  local dow hour
  dow=$(date +%a); hour=$(date +%-H)
  [[ " $WORK_DAYS " == *" $dow "* ]] || return 1
  (( hour >= WORK_START && hour < WORK_END ))
}

session_ceiling() {  # session_ceiling <secs_left>
  local mins=$(( $1 / 60 ))
  # A reading taken as the window rolls is about to be replaced: utilization
  # already reports the fresh window's 0% while secs_left still reports the old
  # one's last seconds. Untreated that puts a brand-new window in the final
  # tier at its most permissive ceiling -- the one moment the design exists to
  # keep clear. Observed 2026-09-15 15:10.
  (( $1 < GRACE_SEC )) && { echo 0; return; }
  if (( mins > TAIL_MIN )); then echo 0
  elif (( mins > FINAL_MIN )); then
    in_work_hours && echo "$CEIL_WORK_TAIL" || echo "$CEIL_OFF_TAIL"
  else
    in_work_hours && echo "$CEIL_WORK_FINAL" || echo "$CEIL_OFF_FINAL"
  fi
}

# The step in effect is the one set at the most recent WORK_END boundary. If
# that boundary predates the weekly reset the window is fresh and the answer is
# zero -- which is what keeps the Saturday afternoon reset from inheriting
# Friday's 100% and draining a new week on the evening before the busiest day
# of it.
weekly_ceiling() {  # weekly_ceiling <secs_left_in_week>
  local left=$1 now boundary wstart
  (( left < 0 )) && { echo 100; return; }                 # no weekly limit reported
  now=$(date +%s)
  if (( $(date +%-H) >= WORK_END )); then
    boundary=$(date -d "today $WORK_END:00" +%s)
  else
    boundary=$(date -d "yesterday $WORK_END:00" +%s)
  fi
  wstart=$(( now - (7*86400 - left) ))
  (( boundary < wstart )) && { echo 0; return; }
  case "$(date -d "@$boundary" +%a)" in
    Sun) echo "$WEEK_SUN" ;; Mon) echo "$WEEK_MON" ;;
    Tue) echo "$WEEK_TUE" ;; Wed) echo "$WEEK_WED" ;;
    Thu) echo "$WEEK_THU" ;; Fri) echo "$WEEK_FRI" ;;
    *)   echo 0 ;;                                        # Saturday: post-reset
  esac
}

# --- projects and state -----------------------------------------------------
# Discovery reads origin/main, not the working tree: the main checkout on this
# host sits on whatever branch someone last used, so a working-tree test would
# make the brief's existence depend on an unrelated checkout's state.
grind_projects() {  # every project whose origin/main carries a GRIND.md
  local d
  for d in "$projects_dir"/*/; do
    d=${d%/}
    git -C "$d" cat-file -e "origin/main:$GRIND_DOC" 2>/dev/null && printf '%s\n' "$d"
  done
}

ghq() { local dir="$1"; shift; ( cd "$dir" && gh "$@" ); }

claude_bin() {
  if [[ -n "${CLAUDE_BIN:-}" && -x "$CLAUDE_BIN" ]]; then echo "$CLAUDE_BIN"
  elif [[ -x "$HOME/.claude/local/claude" ]]; then echo "$HOME/.claude/local/claude"
  elif [[ -x "$HOME/.local/bin/claude" ]]; then echo "$HOME/.local/bin/claude"
  else command -v claude
  fi
}

# --- classifying how a run stopped ------------------------------------------
# A rate-limited run reports subtype "success" with is_error true and
# api_error_status 429, so the 429 test must come first or abandoned work is
# recorded as finished. Anything unrecognised counts as interrupted: a
# mistaken retry costs a window, a mistaken "done" loses the work.
classify() {  # classify <result-json-file>
  jq -r 'if   .api_error_status == 429             then "interrupted rate_limit"
         elif .subtype == "error_max_budget_usd"   then "interrupted brake"
         elif .subtype == "error_max_turns"        then "interrupted turns"
         elif .subtype == "success" and (.is_error | not) then "done ok"
         else "interrupted " + (.subtype // "unknown") end' "$1" 2>/dev/null \
    || echo "interrupted crashed"
}

session_id_of() { jget "$1" '.session_id // ""'; }

# --- spawning ---------------------------------------------------------------
# Returns the result json path on stdout; caller classifies it. The appended
# system prompt is passed on a session's first turn only: the CLI records it
# then and replays the record on every resume, a human's `claude --resume`
# included.
run_claude() {  # run_claude <worktree> <prompt-file> [resume-session-id] [system-file]
  local wt="$1" promptf="$2" resume="${3:-}" sysf="${4:-}" out
  out=$(mktemp "$STATE_DIR/result.XXXXXX.json")
  local -a args=(-p --output-format json --model "$MODEL"
                 --max-budget-usd "$BRAKE_USD" --permission-mode auto)
  [[ -n "$resume" ]] && args+=(--resume "$resume")
  [[ -n "$sysf" ]] && args+=(--append-system-prompt "$(cat "$sysf")")
  ( cd "$wt" && "$(claude_bin)" "${args[@]}" <"$promptf" ) >"$out" 2>/dev/null
  printf '%s' "$out"
}

# --- selecting --------------------------------------------------------------
SELECT_SCHEMA='{"type":"object","additionalProperties":false,
  "required":["selected","ticket","skills","passage","reason"],
  "properties":{"selected":{"type":"boolean"},
                "ticket":{"type":["integer","null"]},
                "skills":{"type":"array","items":{"type":"string"}},
                "passage":{"type":"string"},
                "reason":{"type":"string"}}}'

# Read-only by construction, not by instruction: it reads untrusted issue text,
# so it gets no tool that writes. --restricted drops every settings file, whose
# allow rules would otherwise widen the list below; dontAsk denies the rest.
run_selector() {  # run_selector <worktree> <grind-md>  -- prints the result json path
  local wt="$1" doc="$2" out promptf
  out=$(mktemp "$STATE_DIR/select.XXXXXX.json")
  promptf=$(mktemp "$STATE_DIR/brief.XXXXXX")
  {
    cat <<'BRIEF'
You are the selector for claude-rc-grind, running unattended with nobody
watching. Your only job is to decide what the next grind run works on. A
separate session does the work. You change nothing: no comments, labels,
edits, commits or files. Use gh to read issues and pull requests (never
`--watch`), and read files in this repository where GRIND.md calls for it.

The project's GRIND.md follows. Apply its selection rules to the repository's
current state, exactly as written, and answer with:

- selected: false when nothing GRIND.md describes is eligible right now. That
  is a normal outcome, not a failure. When false, ticket is null, skills is []
  and passage is "".
- ticket: the number of the issue or pull request the work is on, or null when
  the work is not about any single one.
- passage: the text of GRIND.md that describes the work you chose, copied
  verbatim -- the whole item or paragraph, Markdown and all. It is checked
  character for character against GRIND.md, whitespace aside, and the run is
  refused if it does not match. Do not paraphrase, abridge or join pieces.
- skills: every slash-command skill that passage names, in the order the work
  uses them, by name without the slash -- ["implement", "review"] for a passage
  that says to load /implement and then run /review. Only names written as
  /name in the passage; [] when it names none.
- reason: one or two sentences on why this item and this ticket, for the log.

BRIEF
    cat "$doc"
  } >"$promptf"
  ( cd "$wt" && "$(claude_bin)" -p --output-format json --model "$SELECT_MODEL" \
      --max-budget-usd "$SELECT_BRAKE_USD" --restricted --permission-mode dontAsk \
      --tools "Bash,Read,Grep,Glob" \
      --allowedTools "Bash(gh issue list:*)" "Bash(gh issue view:*)" \
                     "Bash(gh pr list:*)" "Bash(gh pr view:*)" "Bash(gh pr checks:*)" \
                     "Bash(jq:*)" Read Grep Glob \
      --json-schema "$SELECT_SCHEMA" <"$promptf" ) >"$out" 2>/dev/null
  rm -f "$promptf"
  printf '%s' "$out"
}

squash() { tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//'; }

# Every claim the selector makes is checked against GRIND.md or is an integer;
# nothing it wrote in its own words survives. Sets sel_ticket (may be empty),
# sel_passage and sel_skills, and sel_why on any refusal.
# Returns 0 when selected and sound, 1 when nothing was selected, 2 on refusal.
vet_selection() {  # vet_selection <select-result-json> <grind-md>
  local res="$1" doc="$2" verdict why selected s re
  sel_ticket= sel_passage= sel_skills=() sel_why=
  read -r verdict why < <(classify "$res")
  [[ "$verdict" == done ]] || { sel_why="selector $why"; return 2; }
  selected=$(jget "$res" '.structured_output.selected | if . == null then "missing" else tostring end')
  [[ "$selected" == false ]] && return 1
  [[ "$selected" == true ]] || { sel_why="no structured output"; return 2; }

  sel_ticket=$(jget "$res" '.structured_output.ticket // ""')
  [[ -z "$sel_ticket" || "$sel_ticket" =~ ^[1-9][0-9]{0,8}$ ]] \
    || { sel_why="ticket is not a number"; return 2; }

  sel_passage=$(jget "$res" '.structured_output.passage // ""' | squash)
  (( ${#sel_passage} >= PASSAGE_MIN )) || { sel_why="passage under $PASSAGE_MIN chars"; return 2; }
  squash <"$doc" | grep -qF -- "$sel_passage" \
    || { sel_why="passage is not an excerpt of $GRIND_DOC"; return 2; }

  while IFS= read -r s; do
    [[ "$s" =~ ^[a-z0-9][a-z0-9:_-]*$ ]] || { sel_why="skill name '$s' refused"; return 2; }
    # Bounded so /review does not vouch for /re: the name must end where a
    # skill name can, and start after something that cannot belong to a path.
    re="[^A-Za-z0-9_./:-]/${s}([^A-Za-z0-9_:-]|\$)"
    [[ " $sel_passage " =~ $re ]] || { sel_why="passage does not name /$s"; return 2; }
    sel_skills+=("$s")
  done < <(jget "$res" '.structured_output.skills[]?')
  return 0
}

# --- executing --------------------------------------------------------------
# The operating rules are inlined rather than left for the agent to load: they
# are what keeps an unattended run to one item and off a sleep loop, and a
# skill the agent never thought to open binds nothing. Frontmatter stripped.
# Every value but GRIND.md's own text comes from the active record, and every
# one of those was vetted on the way in.
brief_system() {  # brief_system <grind-md>
  local f doc="$1" ticket passage skills
  ticket=$(jget "$STATE" '.active.ticket // ""')
  passage=$(jget "$STATE" '.active.passage // ""')
  skills=$(jget "$STATE" '[.active.steps[]? | select(. != "") | "/" + .] | join(", ")')
  f=$(mktemp "$STATE_DIR/brief.XXXXXX")
  {
    printf 'You are running unattended under claude-rc-grind, with nobody watching.\n'
    printf 'How to run as a grind job comes first, then the project brief, %s.\n' "$doc"
    printf 'Both are reproduced in full below. Follow them exactly.\n\n'
    awk 'NR == 1 && /^---$/ { fm = 1; next } fm && /^---$/ { fm = 0; next } !fm' "$GRIND_SKILL"
    printf '\n---\n\n'
    cat "$doc"
    printf '\n---\n\n# Your assignment\n\n'
    printf 'The engine has already selected your work item. Do not select another.\n\n'
    if [[ -n "$ticket" ]]; then printf 'Ticket: #%s\n\n' "$ticket"
    else printf 'Ticket: none -- the work is not about a single issue or pull request.\n\n'; fi
    printf 'The work, as GRIND.md describes it:\n\n%s\n' "$passage"
    if [[ -n "$skills" ]]; then
      printf '\nThe engine invokes these skills for you, each as its own turn, in this order: %s.\n' "$skills"
      printf 'Do not invoke them yourself. In each turn, do the part of the work that\n'
      printf 'belongs with that skill and whatever GRIND.md puts between it and the next,\n'
      printf 'then stop; the engine sends the next. Work GRIND.md puts after the last\n'
      printf 'skill belongs to the last turn. If you stall, the label you add for a\n'
      printf 'human ends the job: the engine sends nothing further.\n'
    fi
  } >"$f"
  printf '%s' "$f"
}

step_prompt() {  # step_prompt <step-index>
  local f skill ticket
  skill=$(jget "$STATE" '.active.steps[$i | tonumber] // ""' --arg i "$1")
  ticket=$(jget "$STATE" '.active.ticket // ""')
  f=$(mktemp "$STATE_DIR/brief.XXXXXX")
  if [[ -n "$skill" ]]; then
    printf '/%s%s\n' "$skill" "${ticket:+ $ticket}" >"$f"
  else
    printf 'Do the work item in your assignment, end to end, then stop.\n' >"$f"
  fi
  printf '%s' "$f"
}

brief_resume() {
  local f; f=$(mktemp "$STATE_DIR/brief.XXXXXX")
  cat >"$f" <<'BRIEF'
A human has intervened since you stopped, and your picture of this working tree
may be stale. Before continuing: re-read the working tree, re-read the issue
thread, and confirm the work is still needed and still yours to do. If a human
has already done it, say so and stop. Otherwise carry on from where you were.
BRIEF
  printf '%s' "$f"
}

# --- parking ----------------------------------------------------------------
issue_of() {  # the engine writes .grind-item from the vetted selection, before the executor starts
  local wt="$1"
  [[ -f "$wt/.grind-item" ]] || return 1
  grep -oE '[0-9]+' "$wt/.grind-item" | head -1
}

# Attribute first, and lock only once we can. A park exists to hand a worktree
# to a human, and every handle on it is the issue number: the unpark check, the
# transcript-age warning and the comment carrying the `claude --resume` line all
# skip a record whose issue is empty. Parking one anyway would hold a MAX_PARKED
# slot nothing could ever release, and the lock -- which gotaspot's reaper reads
# as a refusal (scripts/reap-worktrees.sh, is_locked) -- would strand the
# directory on disk for good. So a job with no .grind-item -- one whose work is
# on no single ticket -- is abandoned, not parked, and left for the reaper.
park() {  # park <worktree> <session_id> <repo> <attempts> <stops>
  local wt="$1" sid="$2" repo="$3" attempts="$4" stops="$5" issue
  issue=$(issue_of "$wt") || issue=
  if [[ -z "$issue" ]]; then
    state_jq '.active = null'
    log "abandon worktree=$wt session=$sid attempts=$attempts stops=$stops no .grind-item"
    say "abandoned: $wt (no ticket to hand a human; left for the reaper)"
    return
  fi
  git -C "$repo" worktree lock --reason \
      "grind: parked for a human, session $sid, $(date -Is)" "$wt" 2>/dev/null
  if (( dry_run == 0 )); then
    ghq "$repo" issue comment "$issue" \
      --body "$(printf 'Parked by GRIND after %s attempts (%s).\n\nPick it up where it stopped, with its full context:\n\n```\ncd %s\nclaude --resume %s\n```\n\nRemoving the `needs-human-intervention` label hands it back to GRIND.\n' \
                "$attempts" "$stops" "$wt" "$sid")" >/dev/null 2>&1
    ghq "$repo" issue edit "$issue" --add-label needs-human-intervention >/dev/null 2>&1
  fi
  state_jq '.active = null
            | .parked += [{issue: $issue, session_id: $sid, worktree: $wt, repo: $repo,
                           attempts: ($att | tonumber), stops: $stops,
                           parked_at: $now, warned: false}]' \
    --arg issue "$issue" --arg sid "$sid" --arg wt "$wt" --arg repo "$repo" \
    --arg att "$attempts" --arg stops "$stops" --arg now "$(date -Is)"
  log "park worktree=$wt session=$sid issue=$issue attempts=$attempts stops=$stops"
  say "parked: $wt (issue $issue, session $sid)"
}

# A worktree with no ticket and nothing in it is one nobody will ever look at:
# a selection that came back empty or refused leaves one every wake on a queue
# stalled on human input, and so does a ticketless job that finished. Callers
# reach this only when a session stopped on its own -- a 429 or a brake is
# `interrupted` and goes to resume instead. Removal is only ever `git worktree
# remove` without --force, and only with no .env: a worktree that brought up a
# stack is left for the reaper, which tears it down. Anything with a ticket is
# left for the reaper as well.
tidy() {  # tidy <repo> <worktree>
  local repo="$1" wt="$2" branch dirty
  issue_of "$wt" >/dev/null && return
  dirty=$(git -C "$wt" status --porcelain 2>/dev/null) || return
  [[ -z "$dirty" && ! -e "$wt/.env" ]] || return
  [[ -z "$(git -C "$wt" log --oneline HEAD --not --remotes 2>/dev/null)" ]] || return
  branch=$(git -C "$wt" symbolic-ref --short -q HEAD)
  git -C "$repo" worktree remove "$wt" 2>/dev/null || return
  [[ "$branch" == grind/* ]] && git -C "$repo" branch -D "$branch" >/dev/null 2>&1
  log "tidy removed worktree=$wt branch=$branch no ticket, nothing left in it"
}

# --- the active job's turns ---------------------------------------------------
# A job is a list of steps: one per skill the selection named, or a single ""
# for work that names none. Each step is a user turn on one session -- the first
# starts it, the rest resume it -- since a skill only a user may start cannot be
# reached from inside another. next_step is bumped before its turn launches, so
# an interrupted step is finished by a resume turn, never re-issued.

interrupted() {  # interrupted <why>  -- count the stop; park past MAX_ATTEMPTS
  local why="$1" wt sid repo attempts stops
  wt=$(jget "$STATE" '.active.worktree // ""')
  sid=$(jget "$STATE" '.active.session_id // ""')
  repo=$(jget "$STATE" '.active.repo // ""')
  attempts=$(( $(jget "$STATE" '.active.attempts // 0') + 1 ))
  stops=$(jget "$STATE" '.active.stops // ""'); stops="${stops:+$stops,}$why"
  if (( attempts > MAX_ATTEMPTS )); then
    park "$wt" "$sid" "$repo" "$attempts" "$stops"
  else
    state_jq '.active.attempts = ($att | tonumber) | .active.stops = $stops' \
      --arg att "$attempts" --arg stops "$stops"
    log "interrupted $why worktree=$wt session=$sid attempts=$attempts"
    say "interrupted ($why); will resume"
  fi
}

turn() {  # turn <prompt-file>  -- 0 when the session stopped on its own
  local promptf="$1" wt sid sysf= res verdict why
  wt=$(jget "$STATE" '.active.worktree // ""')
  sid=$(jget "$STATE" '.active.session_id // ""')
  [[ -z "$sid" ]] && sysf=$(brief_system "$wt/$GRIND_DOC")
  res=$(run_claude "$wt" "$promptf" "$sid" "$sysf"); [[ -n "$sysf" ]] && rm -f "$sysf"
  if [[ -z "$sid" ]]; then
    sid=$(session_id_of "$res")
    [[ -n "$sid" ]] && state_jq '.active.session_id = $sid' --arg sid "$sid"
  fi
  read -r verdict why < <(classify "$res"); rm -f "$res"
  [[ "$verdict" == done ]] && return 0
  interrupted "$why"; return 1
}

# A turn that stalled -- labelled its ticket for a human and stopped -- ended on
# its own as far as classify can tell; the label is the only sign. Sending the
# next skill into it would carry on past a question nobody has answered yet.
stalled() {
  local repo ticket
  repo=$(jget "$STATE" '.active.repo // ""'); ticket=$(jget "$STATE" '.active.ticket // ""')
  [[ -n "$ticket" ]] || return 1
  ghq "$repo" issue view "$ticket" --json labels --jq '.labels[].name' 2>/dev/null \
    | grep -qx needs-human-intervention
}

drive() {  # run the active job's remaining steps; record how it ends
  local n step pf wt repo
  n=$(jget "$STATE" '.active.steps | length')
  while step=$(jget "$STATE" '.active.next_step // 0'); (( step < n )); do
    if (( step > 0 )) && stalled; then
      log "stalled before step $step worktree=$(jget "$STATE" '.active.worktree // ""')"
      break
    fi
    state_jq '.active.next_step += 1'
    pf=$(step_prompt "$step")
    turn "$pf" || { rm -f "$pf"; return; }
    rm -f "$pf"
  done
  wt=$(jget "$STATE" '.active.worktree // ""'); repo=$(jget "$STATE" '.active.repo // ""')
  log "done worktree=$wt session=$(jget "$STATE" '.active.session_id // ""') steps=$n"
  state_jq '.active = null'
  tidy "$repo" "$wt"
  say "completed: $wt"
}

# A parked record whose issue no longer carries the label is ours again.
# Tab-separated, and the callers read with IFS set to tab: a worktree path can
# contain spaces, and a blank issue field must stay a field rather than vanish.
parked_ready_index() {
  jq -r '(.parked // []) | to_entries[]
         | [(.key | tostring), (.value.issue // ""), (.value.worktree // ""),
            (.value.session_id // ""), (.value.repo // "")] | @tsv' "$STATE" 2>/dev/null
}

# --- a fresh worktree, and what to do in it ----------------------------------
new_worktree() {  # new_worktree <repo> <worktree> <ts>
  local repo="$1" wt="$2" ts="$3" excl
  # Branch from a freshly fetched origin/main: the local main on this host runs
  # tens of commits behind, and a stale base also means a stale reap script in
  # the worktree, which is what decides how its own cleanup behaves.
  git -C "$repo" fetch --quiet origin main 2>/dev/null
  # .grind-item is the engine's file, not the project's, so it is ignored here
  # rather than in each project's .gitignore. info/exclude lives in the common git
  # dir, so this one line covers every worktree of the clone. Untracked, the file
  # made the reaper read a finished worktree as uncommitted work and keep it.
  excl=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/info/exclude
  grep -qxF /.grind-item "$excl" 2>/dev/null \
    || { mkdir -p "${excl%/*}" && echo /.grind-item >>"$excl"; }
  if ! git -C "$repo" worktree add -b "grind/$ts" "$wt" origin/main >/dev/null 2>&1; then
    log "error could not create worktree $wt"; return 1
  fi
  # The one gitignored file Claude Code itself copies into a worktree it makes.
  # Never .env or apps/web/.dev.vars: those carry a port-block claim and a
  # path-derived compose project name, and setup:worktree generates them.
  [[ -f "$repo/.claude/settings.local.json" ]] \
    && cp "$repo/.claude/settings.local.json" "$wt/.claude/settings.local.json" 2>/dev/null
  return 0
}

# Selection runs before any job is recorded: a selector that fails, finds
# nothing or is refused leaves no .active behind, so it costs no attempt and
# the next wake simply asks again. GRIND.md is the worktree's own copy, so it
# always matches the base the work is done on rather than whatever the shared
# checkout happens to have. Returns as vet_selection does.
select_into() {  # select_into <repo> <worktree>
  local repo="$1" wt="$2" res rc
  res=$(run_selector "$wt" "$wt/$GRIND_DOC")
  vet_selection "$res" "$wt/$GRIND_DOC"; rc=$?
  log "select repo=$repo rc=$rc ticket=${sel_ticket:-none} skills=${sel_skills[*]:-none} reason=$(jget "$res" '.structured_output.reason // "" | gsub("\\s+"; " ")')"
  rm -f "$res"
  return "$rc"
}

# --- subcommands ------------------------------------------------------------
case "$mode" in
  hold)
    date -d "+$hold_hours hours" +%s >"$HOLD"
    say "holding until $(date -d "+$hold_hours hours" '+%F %H:%M')"; exit 0 ;;
  release)
    rm -f "$HOLD"; say "hold released"; exit 0 ;;
  select)
    # Costs a selector run, so it is opt-in; skips the quota gates and touches
    # no job state, but takes the lock so it cannot race a wake for the tree.
    exec 9>"$LOCKFILE"
    flock -n 9 || { say "a wake holds the lock; try again shortly"; exit 1; }
    repo=$(grind_projects | head -1)
    [[ -n "$repo" ]] || { say "no project has a $GRIND_DOC"; exit 0; }
    ts=select-$(date +%Y%m%d-%H%M%S); wt="$repo/.claude/worktrees/grind-$ts"
    new_worktree "$repo" "$wt" "$ts" || { say "could not create $wt"; exit 1; }
    select_into "$repo" "$wt"; rc=$?
    case $rc in
      0) say "ticket:  ${sel_ticket:-none}"
         say "steps:   ${sel_skills[*]:-(no skill)}"
         say "passage: $sel_passage" ;;
      1) say "nothing eligible" ;;
      *) say "refused: $sel_why" ;;
    esac
    tidy "$repo" "$wt"
    exit 0 ;;
  status)
    if q=$(read_quota); then
      set -- $q
      say "session   $1%  ($(( $2 / 60 )) min left)   ceiling now $(session_ceiling "$2")%"
      say "weekly    $3%  ($(( $4 / 3600 ))h left)    ceiling now $(weekly_ceiling "$4")%"
    else
      say "quota reading unavailable"
    fi
    in_work_hours && say "working hours: yes" || say "working hours: no"
    [[ -f "$HOLD" ]] && (( $(cat "$HOLD") > $(date +%s) )) \
      && say "HOLD until $(date -d "@$(cat "$HOLD")" '+%F %H:%M')"
    say "active: $(jget "$STATE" '.active.worktree // "none"')"
    say "parked: $(jget "$STATE" '(.parked // []) | length')"
    exit 0 ;;
esac

# --- one wake ---------------------------------------------------------------
exec 9>"$LOCKFILE"
flock -n 9 || { log "skip another instance holds the lock"; exit 0; }

if [[ -f "$HOLD" ]] && (( $(cat "$HOLD" 2>/dev/null || echo 0) > $(date +%s) )); then
  log "skip hold until $(date -d "@$(cat "$HOLD")" -Is)"; exit 0
fi

# Reconcile: an active record whose run never reported back (the governor was
# killed mid-job) is an interruption like any other.
active_wt=$(jget "$STATE" '.active.worktree // ""')
if [[ -n "$active_wt" && ! -d "$active_wt" ]]; then
  log "reconcile active worktree vanished, clearing $active_wt"
  state_jq '.active = null'
  active_wt=
fi

q=$(read_quota) || { log "skip quota reading failed"; exit 0; }
set -- $q
sess_pct=$1 sess_left=$2 week_pct=$3 week_left=$4
sess_ceil=$(session_ceiling "$sess_left")
week_ceil=$(weekly_ceiling "$week_left")

# Two meters, so two gates -- not a min() of two percentages that measure
# different things. Both must pass.
log "wake session=${sess_pct}%/${sess_ceil}% weekly=${week_pct}%/${week_ceil}% mins_left=$(( sess_left / 60 )) work=$(in_work_hours && echo y || echo n)"

if (( sess_pct >= sess_ceil )) || (( week_pct >= week_ceil )); then
  reason="session ${sess_pct}% vs ${sess_ceil}%"
  (( week_pct >= week_ceil )) && reason="weekly ${week_pct}% vs ${week_ceil}%"
  log "hold $reason"
  (( dry_run )) && say "would not run: $reason"
  exit 0
fi

(( dry_run )) && say "headroom: session ${sess_pct}%/${sess_ceil}%, weekly ${week_pct}%/${week_ceil}%"

# 1. An active (interrupted) job outranks everything.
if [[ -n "$active_wt" ]]; then
  sid=$(jget "$STATE" '.active.session_id // ""')
  repo=$(jget "$STATE" '.active.repo // ""')
  attempts=$(jget "$STATE" '.active.attempts // 0')
  if (( dry_run )); then say "would resume $active_wt (session $sid, attempt $((attempts+1)))"; exit 0; fi
  # A record from before steps existed ran its whole job in one turn.
  state_jq '.active.steps //= [""] | .active.next_step //= 1'
  if [[ -z "$sid" ]]; then
    # No session came back, so no step got as far as a transcript: issue the
    # interrupted one again rather than resume nothing.
    state_jq '.active.next_step = ([.active.next_step - 1, 0] | max)'
    drive
  else
    bf=$(brief_resume); turn "$bf" && drive; rm -f "$bf"
  fi
  exit 0
fi

# 2. A parked job whose label has been removed is ours again.
while IFS=$'\t' read -r idx issue wt sid repo; do
  [[ -n "$issue" ]] || continue
  labels=$(ghq "$repo" issue view "$issue" --json labels --jq '[.labels[].name]|join(",")' 2>/dev/null)
  [[ -n "$labels" ]] || continue
  [[ "$labels" == *needs-human-intervention* ]] && continue
  if (( dry_run )); then say "would unpark #$issue ($wt)"; exit 0; fi
  git -C "$repo" worktree unlock "$wt" 2>/dev/null
  state_jq '($i | tonumber) as $n
            | .active = (.parked[$n] | .attempts = 0 | .stops = "")
            | .parked = (.parked | del(.[$n]))' --arg i "$idx"
  log "unpark issue=$issue worktree=$wt"
  say "unparked #$issue; will resume on the next wake"
  exit 0
done < <(parked_ready_index)

# 3. Nothing outstanding: start a fresh item, if there is room to park a failure.
parked_n=$(jget "$STATE" '(.parked // []) | length')
if (( parked_n >= MAX_PARKED )); then
  log "stop parked=$parked_n at MAX_PARKED; queue is jammed on human input, not quota"
  say "not starting: $parked_n parked jobs waiting on you (max $MAX_PARKED)"
  exit 0
fi

# Warn once when a parked session is about to outlive its transcript.
while IFS=$'\t' read -r idx issue wt sid repo; do
  [[ -n "$issue" ]] || continue
  pa=$(jget "$STATE" '.parked[$i | tonumber].parked_at // ""' --arg i "$idx")
  warned=$(jget "$STATE" '.parked[$i | tonumber].warned // false' --arg i "$idx")
  [[ "$warned" == true ]] && continue
  age=$(( ( $(date +%s) - $(date -d "$pa" +%s 2>/dev/null || echo 0) ) / 86400 ))
  (( age < PARK_WARN_DAYS )) && continue
  (( dry_run )) || ghq "$repo" issue comment "$issue" --body \
    "This session has been parked $age days. Transcripts age out at 30, after which \`claude --resume\` will no longer find it — the branch and its commits survive, the context does not." >/dev/null 2>&1
  state_jq '.parked[$i | tonumber].warned = true' --arg i "$idx"
  log "warn issue=$issue parked ${age}d"
done < <(parked_ready_index)

repo=$(grind_projects | head -1)
if [[ -z "$repo" ]]; then
  log "idle no project has a $GRIND_DOC"
  (( dry_run )) && say "no project has a $GRIND_DOC"
  exit 0
fi

# A rough gate, not the selection: GRIND.md decides that, and may still pass on
# everything counted here (a ticket with an open PR, say). But with nothing below
# there is certainly nothing to select, and spawning a session every wake to find
# that out is what drains a stalled queue's windows. A failed gh call is a
# refusal, like a failed quota reading.
#
# An issue counts when it is not parked or stalled, carries a label some work
# item acts on, and -- for a grilling ticket -- its latest comment is not an
# agent's. A grilling round is answered in the thread with no relabel, so an
# agent speaking last means the round is still open; anyone else speaking last
# may be an answer, and the session reads the thread to decide. A pull request
# counts when it waits on its author: changes-requested, a conflict, or a failed
# check on its latest commit (GRIND.md item 0).
open_issues=$(ghq "$repo" issue list --label grind --state open --limit 100 --json labels,comments \
    --jq '[.[] | select(all(.labels[]; .name != "needs-human-intervention"))
               | select(any(.labels[]; .name | IN("ready-for-agent", "needs-research",
                                                  "needs-grilling", "needs-triage")))
               | select((any(.labels[]; .name == "needs-grilling") | not)
                        or ((.comments | sort_by(.createdAt) | last | .body // "")
                            | test("<!-- agent ") | not))] | length' 2>/dev/null)
open_prs=$(ghq "$repo" pr list --label grind --state open --limit 100 \
    --json labels,mergeable,statusCheckRollup \
    --jq '[.[] | select(all(.labels[]; .name != "needs-human-intervention"))
               | select(any(.labels[]; .name == "changes-requested")
                        or .mergeable == "CONFLICTING"
                        or any(.statusCheckRollup[]?; (.conclusion // .state) as $c
                               | ["FAILURE","ERROR","TIMED_OUT","ACTION_REQUIRED","STARTUP_FAILURE"]
                               | index($c)))] | length' 2>/dev/null)
if [[ -z "$open_issues" || -z "$open_prs" ]]; then
  log "skip could not list grind issues and pull requests in $repo"
  (( dry_run )) && say "could not list grind issues and pull requests"
  exit 0
fi
if (( open_issues + open_prs == 0 )); then
  log "idle no grind issue or pull request with work waiting in $repo"
  (( dry_run )) && say "nothing eligible: no open grind issue or pull request needing work"
  exit 0
fi

if [[ ! -r "$GRIND_SKILL" ]]; then
  log "error operating rules missing at $GRIND_SKILL"; say "missing $GRIND_SKILL"; exit 1
fi

ts=$(date +%Y%m%d-%H%M%S)
wt="$repo/.claude/worktrees/grind-$ts"
if (( dry_run )); then
  say "would start a new item in $repo -> $wt"
  exit 0
fi

new_worktree "$repo" "$wt" "$ts" || { say "could not create $wt"; exit 1; }
select_into "$repo" "$wt"; rc=$?
case $rc in
  1) log "idle selector found nothing eligible in $repo"
     tidy "$repo" "$wt"; exit 0 ;;
  2) log "refuse selection in $repo: $sel_why"
     say "selection refused: $sel_why"
     tidy "$repo" "$wt"; exit 0 ;;
esac

# Everything recorded here was vetted by vet_selection; brief_system and
# step_prompt build the executor's turns from this record alone.
steps='[""]'
(( ${#sel_skills[@]} )) && steps=$(printf '%s\n' "${sel_skills[@]}" | jq -R . | jq -sc .)
[[ -n "$sel_ticket" ]] && printf '%s\n' "$sel_ticket" >"$wt/.grind-item"
state_jq '.active = {worktree: $wt, repo: $repo, session_id: "", attempts: 0,
                     stops: "", started_at: $now,
                     ticket: $ticket, passage: $passage,
                     steps: $steps, next_step: 0}' \
  --arg wt "$wt" --arg repo "$repo" --arg now "$(date -Is)" \
  --arg ticket "$sel_ticket" --arg passage "$sel_passage" --argjson steps "$steps"
log "start repo=$repo worktree=$wt ticket=${sel_ticket:-none} steps=${sel_skills[*]:-none}"
drive

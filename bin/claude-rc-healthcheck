#!/usr/bin/env bash
# claude-rc-healthcheck
#
# Re-runs claude-rc-window for every enabled claude-rc@<name>.service
# instance, respawning any that died (crash, `claude update`, etc.) since
# tmux windows aren't supervised by systemd once created. Driven by
# claude-rc-healthcheck.timer.
set -euo pipefail

wants_dir="$HOME/.config/systemd/user/claude-rc.target.wants"
[[ -d "$wants_dir" ]] || exit 0

shopt -s nullglob
for unit in "$wants_dir"/claude-rc@*.service; do
  base="$(basename "$unit")"
  name="${base#claude-rc@}"
  name="${name%.service}"
  "$HOME/.local/bin/claude-rc-window" "$name" || echo "claude-rc-healthcheck: failed for $name" >&2
done

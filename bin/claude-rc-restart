#!/usr/bin/env bash
# claude-rc-restart [--all | <name>...] [--force]
#
# Restart claude rc instances -- but not the one you are running in.
#
# A restart keeps an instance's sessions (README, "Restarting an instance")
# and kills whatever turn each worker is in the middle of. So for every
# instance named this prints how many workers are live, so the caller can
# choose to wait, and refuses the instance that serves the calling shell:
# that session would lose its turn with nobody left to send the next
# message. --force is for a caller who has decided to accept that.
#
# <name> is the instance name (claude-rc@<name>.service) or "general".
# --all is every running instance, minus the caller's own: the step after
# `claude update`, since workers already exec the new binary and only the
# servers stay old.
set -uo pipefail

usage() { echo "usage: claude-rc-restart [--all | <name>...] [--force]" >&2; exit 2; }

all=0 force=0 names=()
for a in "$@"; do
  case "$a" in
    --all)     all=1 ;;
    --force)   force=1 ;;
    -h|--help) usage ;;
    -*)        echo "claude-rc-restart: unknown option: $a" >&2; usage ;;
    *)         names+=("$a") ;;
  esac
done
if (( all )); then (( ${#names[@]} == 0 )) || usage
else (( ${#names[@]} > 0 )) || usage; fi

unit_of() { if [[ "$1" == general ]]; then echo claude-rc-general.service; else echo "claude-rc@$1.service"; fi; }
name_of() { local n=${1#claude-rc@}; n=${n%.service}; [[ "$1" == claude-rc-general.service ]] && n=general; echo "$n"; }

units=()
if (( all )); then
  mapfile -t units < <(systemctl --user list-units --plain --no-legend --state=active \
                         'claude-rc@*.service' claude-rc-general.service | awk '{print $1}')
else
  for n in "${names[@]}"; do units+=("$(unit_of "$n")"); done
fi

# The instance serving this shell is the one whose MainPID is an ancestor of
# this process. Nothing in the environment says so; the ancestry does.
ancestors=(); p=$$
while [[ -n "$p" && "$p" != 1 ]]; do
  ancestors+=("$p"); p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
done
is_ancestor() { local a; for a in "${ancestors[@]}"; do [[ "$a" == "$1" ]] && return 0; done; return 1; }

rc=0
for u in "${units[@]}"; do
  main=$(systemctl --user show "$u" -p MainPID --value 2>/dev/null)
  if [[ -z "$main" || "$main" == 0 ]]; then
    echo "$u: not running; starting"
    systemctl --user start "$u" || { echo "$u: start failed" >&2; rc=1; }
    continue
  fi
  live=$(pgrep -P "$main" -f -- '--session-id' | wc -l)
  if is_ancestor "$main"; then
    if (( force )); then
      echo "$u: serves this shell; restarting anyway (--force) -- this session's turn ends here"
    else
      echo "$u: serves this shell; skipped. This is your own instance: restart it from elsewhere, or --force." >&2
      rc=1; continue
    fi
  fi
  echo "$u: $live live worker(s); restarting"
  if ! systemctl --user restart "$u"; then echo "$u: restart failed" >&2; rc=1; continue; fi

  out="$HOME/.claude/rc-logs/rc-$(name_of "$u").out"
  for _ in $(seq 1 45); do
    grep -a -q 'Connected' "$out" 2>/dev/null && break
    [[ "$(systemctl --user show "$u" -p ActiveState --value)" == failed ]] && break
    sleep 1
  done
  if grep -a -q 'Connected' "$out" 2>/dev/null; then
    echo "$u: connected (pid $(systemctl --user show "$u" -p MainPID --value)); sessions return on their next message"
  else
    echo "$u: $(systemctl --user show "$u" -p ActiveState --value), and no 'Connected' in $out yet -- check journalctl --user -u $u" >&2
    rc=1
  fi
done
exit $rc
